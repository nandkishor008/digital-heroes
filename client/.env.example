# Where the API lives. Leave unset in development: vite.config.js proxies
# /api to http://localhost:4000, and in production the API is served from the
# same origin as the client.
# VITE_API_URL=https://your-app.vercel.app/api

# Where photographs come from.
#   remote (default) — streamed from the Unsplash CDN
#   local            — served from /images, after `npm run fetch-images`
VITE_IMAGE_SOURCE=remote
