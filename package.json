{
  "name": "digital-heroes",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Heroes — golf performance, monthly charity draw and payout platform",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "setup": "npm run db:migrate && npm run db:seed",
    "test:draw": "node server/scripts/test-draw.js",
    "test": "node server/scripts/test-draw.js",
    "fetch-images": "node server/scripts/fetch-images.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "stripe": "^16.2.0"
  }
}
